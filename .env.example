# Neon / Postgres (Vercel's Neon integration normally injects DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a long random value for production.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Optional but recommended on Vercel for persistent property image uploads.
# Add a Vercel Blob store to the project and Vercel will provide this token.
BLOB_READ_WRITE_TOKEN=
